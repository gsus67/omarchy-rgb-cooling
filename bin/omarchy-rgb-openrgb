#!/usr/bin/env python3
"""Expose only explicitly enabled USB HID nodes to an isolated OpenRGB server."""
# SPDX-License-Identifier: GPL-3.0-or-later
import argparse
import os
import shutil
import sys

sys.dont_write_bytecode = True
from rgb_common import enabled_devices, hidraw_devices, xdg


def command(root):
    for program in ("bwrap", "openrgb"):
        if shutil.which(program) is None:
            raise ValueError(f"{program} is required; install it before enabling RGB control")
    enabled = enabled_devices()
    if any(key.startswith("usb:0416:5302:") for key in enabled):
        raise ValueError("0416:5302 is reserved exclusively for omarchy-trcc")
    nodes = hidraw_devices(root, with_paths=True)
    # Ambiguous USB identities cannot safely identify a user-enabled device.
    locations = {}
    for usb, path in nodes.values():
        locations.setdefault(usb, set()).add(path)
    allowed = [node for node, (usb, _path) in nodes.items()
               if usb in enabled and len(locations[usb]) == 1]
    if not allowed:
        raise ValueError("No enabled, uniquely identified USB HID devices are connected")
    config = xdg("XDG_STATE_HOME", ".local/state") / "openrgb"
    config.mkdir(mode=0o700, parents=True, exist_ok=True)
    args = [shutil.which("bwrap"), "--unshare-all", "--share-net", "--die-with-parent",
            "--new-session"]
    for path in ("/usr", "/etc", "/sys", "/run/udev"):
        args += ["--ro-bind", path, path]
    for name in ("lib", "lib64", "bin", "sbin"):
        args += ["--symlink", f"usr/{name}", f"/{name}"]
    args += ["--proc", "/proc", "--dev", "/dev"]
    for node in allowed:
        args += ["--dev-bind", node, node]
    args += ["--tmpfs", "/tmp", "--bind", str(config), str(config),
             "--setenv", "QT_QPA_PLATFORM", "offscreen", "--setenv", "HOME", str(config),
             "/usr/bin/openrgb", "--server", "--server-host", "127.0.0.1", "--server-port",
             "6742", "--noautoconnect", "--config", str(config), "--loglevel", "warning"]
    return args


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--sys-root", default="/sys", help="Read-only sysfs root for tests")
    args = parser.parse_args()
    try:
        arguments = command(args.sys_root)
        os.execv(arguments[0], arguments)
    except (OSError, ValueError) as error:
        print(f"OpenRGB launcher: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
